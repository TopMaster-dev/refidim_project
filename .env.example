# Database
DATABASE_URL="postgresql://refidim:refidim_dev@localhost:5432/refidim?schema=public"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Auth (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# Cripto de credenciais SMTP/IMAP (fallback para NEXTAUTH_SECRET se vazio)
ENCRYPTION_KEY=""

# IA — escolher um dos provedores
AI_PROVIDER="anthropic"        # "anthropic" | "openai"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_CONVERSATION="claude-haiku-4-5-20251001"
AI_MODEL_CLASSIFICATION="claude-haiku-4-5-20251001"

# WhatsApp (Baileys)
WHATSAPP_SESSION_DIR="./auth_info_baileys"
WHATSAPP_MIN_DELAY_MS="25000"
WHATSAPP_MAX_DELAY_MS="90000"
WHATSAPP_ALLOWED_HOUR_START="7"
WHATSAPP_ALLOWED_HOUR_END="22"

# E-mail (defaults — cada consultor pode sobrescrever no painel)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Stripe
STRIPE_SECRET_KEY=""            # sk_test_... ou sk_live_...
STRIPE_PUBLISHABLE_KEY=""       # pk_test_... ou pk_live_...
STRIPE_WEBHOOK_SECRET=""        # whsec_... (gerado quando você cria o endpoint no dashboard)

# Stripe Price IDs (criar no dashboard de Products do Stripe)
STRIPE_PRICE_START=""           # price_xxx para o plano Start mensal
STRIPE_PRICE_PRO=""             # price_xxx para o plano Pro mensal
STRIPE_PRICE_SCALE=""           # price_xxx para o plano Scale mensal

# Worker / app
APP_URL="http://localhost:3000"
WORKER_LOG_LEVEL="info"
