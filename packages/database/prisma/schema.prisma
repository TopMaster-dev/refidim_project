// Refidim — Prisma schema
// Cobre: User/Plano, Consultor (+ Context, Permissions, Materials),
// ContactList/Contact, Job/Lead, Conversation/Message, WhatsAppSession,
// EmailAccount, ExtractionJob, NextGoPay (Subscription/Payment).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIO + PLANO
// ============================================================

enum PlanTier {
  START
  PRO
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  phone           String?
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription   Subscription?
  consultants    Consultant[]
  contactLists   ContactList[]
  jobs           Job[]
  whatsAppSessions WhatsAppSession[]
  emailAccounts  EmailAccount[]
  extractionJobs ExtractionJob[]
  payments       Payment[]
  alerts         Alert[]
  sessions       AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String             @unique
  plan        PlanTier
  status      SubscriptionStatus @default(TRIAL)
  leadLimit   Int                // 3000 / 8000 / 20000
  leadsUsed   Int                @default(0)
  consultantLimit Int            // 1 / 3 / 999
  currentPeriodStart DateTime    @default(now())
  currentPeriodEnd   DateTime
  nextGoSubscriptionId String?   @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// CONSULTOR + CONTEXTO + PERMISSÕES
// ============================================================

enum ConsultantGoal {
  CAPTURE_INTEREST
  QUALIFY
  SCHEDULE_MEETING
  SEND_PROPOSAL
}

enum ConversationTone {
  CASUAL
  CONSULTIVE
  DIRECT
  CURIOUS
  COMMERCIAL
}

model Consultant {
  id          String           @id @default(cuid())
  userId      String
  name        String
  company     String
  product     String
  audience    String
  tone        ConversationTone @default(CONSULTIVE)
  goal        ConsultantGoal   @default(CAPTURE_INTEREST)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  context     BusinessContext?
  permissions ConsultantPermission?
  materials   ConsultantMaterial[]
  openings    OpeningTemplate[]
  jobs        Job[]

  @@index([userId])
}

// Contexto do negócio (1:1 com Consultant)
model BusinessContext {
  id              String   @id @default(cuid())
  consultantId    String   @unique
  whatYouSell     String   @db.Text
  whoYouSellTo    String   @db.Text
  mainBenefit     String   @db.Text
  differentials   String   @db.Text
  commonObjections Json    // [{ objection: string, idealAnswer: string }]
  conversationGoal String  @db.Text
  glossaryAllowed String[] // termos que pode usar
  glossaryBlocked String[] // termos proibidos
  forbiddenActions String[] // lista de proibições
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
}

// Permissões do consultor (1:1)
model ConsultantPermission {
  id                  String   @id @default(cuid())
  consultantId        String   @unique
  canMentionPrice     Boolean  @default(false)
  canSendLink         Boolean  @default(true)
  canSendPresentation Boolean  @default(true)
  canSuggestMeeting   Boolean  @default(true)
  canAnswerQuestions  Boolean  @default(true)
  callHumanIfOutOfScope Boolean @default(true)
  meetingLink         String?  // Calendly etc
  proposalUrl         String?  // PDF/link
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
}

enum MaterialKind {
  PDF
  LINK
  VIDEO
  IMAGE
  CATALOG
}

// Materiais que a IA pode enviar (PDFs, links, vídeos)
model ConsultantMaterial {
  id           String       @id @default(cuid())
  consultantId String
  kind         MaterialKind
  label        String       // "Apresentação institucional", "Proposta padrão"
  url          String       // local upload ou URL externa
  description  String?      @db.Text
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([consultantId])
}

// Modelos de abertura de conversa (variações para evitar padrão de spam)
model OpeningTemplate {
  id           String   @id @default(cuid())
  consultantId String
  label        String   // "abordagem leve", "consultiva", etc
  text         String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([consultantId])
}

// ============================================================
// LISTAS E CONTATOS
// ============================================================

enum ContactListSource {
  CSV_UPLOAD
  MANUAL_PASTE
  GOOGLE_EXTRACTION
  PAID_TRAFFIC
}

model ContactList {
  id        String            @id @default(cuid())
  userId    String
  name      String
  source    ContactListSource
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts Contact[]
  jobs     Job[]

  @@index([userId])
}

model Contact {
  id            String   @id @default(cuid())
  contactListId String
  name          String?
  company       String?
  phone         String?  // E.164
  email         String?
  metadata      Json?    // dados extras vindos do CSV/extrator
  isOptedOut    Boolean  @default(false)
  createdAt     DateTime @default(now())

  contactList ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  leads       Lead[]

  @@index([contactListId])
  @@index([phone])
  @@index([email])
}

// ============================================================
// TRABALHOS / CAMPANHAS
// ============================================================

enum Channel {
  WHATSAPP
  EMAIL
}

enum JobStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

model Job {
  id            String         @id @default(cuid())
  userId        String
  consultantId  String
  contactListId String
  name          String
  channel       Channel
  goal          ConsultantGoal
  status        JobStatus      @default(DRAFT)
  dailyLimit    Int            @default(100)
  startedAt     DateTime?
  pausedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultant  Consultant  @relation(fields: [consultantId], references: [id])
  contactList ContactList @relation(fields: [contactListId], references: [id])
  leads       Lead[]

  @@index([userId])
  @@index([status])
}

// ============================================================
// LEADS + CONVERSAS
// ============================================================

enum LeadStatus {
  COLD      // frio
  WARM      // morno
  HOT       // quente
  HANDED_OFF // usuário assumiu
  OPTED_OUT
}

model Lead {
  id           String     @id @default(cuid())
  jobId        String
  contactId    String
  status       LeadStatus @default(COLD)
  lastMessageAt DateTime?
  handedOffAt  DateTime?
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id])
  conversation Conversation?
  alerts       Alert[]

  @@unique([jobId, contactId])
  @@index([status])
}

model Conversation {
  id            String   @id @default(cuid())
  leadId        String   @unique
  channel       Channel
  externalId    String?  // chat_id WhatsApp ou thread_id e-mail
  isPaused      Boolean  @default(false) // pausa IA quando humano assume
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([externalId])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageSender {
  AI
  HUMAN
  CONTACT
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  sender         MessageSender
  body           String           @db.Text
  metadata       Json?            // headers e-mail, msg_id whatsapp, etc
  sentAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ============================================================
// CANAIS — WHATSAPP + E-MAIL
// ============================================================

enum WhatsAppStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  QR_PENDING
  BANNED
}

model WhatsAppSession {
  id         String         @id @default(cuid())
  userId     String         @unique // MVP: 1 sessão por conta (multi-consultor compartilha)
  phoneNumber String?       // preenchido após conectar
  status     WhatsAppStatus @default(DISCONNECTED)
  authState  Json?          // serialização do auth_info do Baileys
  qrCode     String?        // base64 do QR atual
  lastConnectedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  consultantId String?  // opcional: e-mail por consultor
  fromEmail    String
  fromName     String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassEnc  String   // criptografado
  imapHost     String?
  imapPort     Int?
  imapUser     String?
  imapPassEnc  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// EXTRATOR
// ============================================================

enum ExtractionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model ExtractionJob {
  id              String           @id @default(cuid())
  userId          String
  segment         String
  city            String
  desiredQuantity Int
  resultListName  String
  status          ExtractionStatus @default(QUEUED)
  extractedCount  Int              @default(0)
  errorMessage    String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// PAGAMENTOS (NEXTGO PAY)
// ============================================================

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  CANCELED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  nextGoPaymentId String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus
  description     String?
  paidAt          DateTime?
  dueAt           DateTime?
  rawPayload      Json?         // payload bruto do webhook NextGo
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// ALERTAS (lead quente, humano necessário)
// ============================================================

enum AlertKind {
  LEAD_HOT
  HUMAN_NEEDED
  OUT_OF_SCOPE
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  leadId    String
  kind      AlertKind
  message   String    @db.Text
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
